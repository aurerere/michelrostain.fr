---
import MenuLink from "../components/MenuLink.astro";
---

<header>
  <div class="right">
    <a class="no-decoration" href="/">
      <h1 class="no-margin">Michel Rostain</h1>
    </a>
  </div>
  <div class="left">
    <menu class="desktop">
      <li>
        <MenuLink label="Romans" to="/romans" />
      </li>
      <li>
        <MenuLink label="Essais" to="/essais" />
      </li>
      <li>
        <MenuLink label="Théatre musical" to="/theatre-musical" />
      </li>
      <li>
        <MenuLink label="Articles divers" to="/articles" />
      </li>
      <li>
        <MenuLink label="Compositeurs" to="/compositeurs" />
      </li>
      <li>
        <MenuLink label="Biographies" to="/biographies" />
      </li>
    </menu>
  </div>
</header>

<script>
  const HEADER_HEIGHT = 136;
  let controller: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    controller?.abort();
    controller = new AbortController();

    const header = document.querySelector("header");
    if (!header) return;

    let prevScrollY = window.scrollY;
    let visible = false;

    window.addEventListener(
      "scroll",
      () => {
        const scrollY = Math.max(0, window.scrollY);
        const delta = scrollY - prevScrollY;

        prevScrollY = scrollY;

        if (scrollY <= HEADER_HEIGHT && delta >= 0) {
          visible = false;
        } else if (delta < 0) {
          visible = true;
        } else if (delta > 0) {
          visible = false;
        }

        header.classList.toggle("visible", visible);
      },
      {
        passive: true,
        signal: controller?.signal,
      },
    );
  });
</script>

<style>
  header {
    box-sizing: border-box;
    width: 100%;

    position: sticky;
    top: calc(var(--header-height) * -1);

    z-index: 10;

    display: flex;
    align-items: center;
    justify-content: space-between;

    height: var(--header-height);
    padding: var(--s24);

    background: var(--bg);
    border-bottom: 1px solid var(--text-color);

    transition: top 250ms ease-in-out;
    gap: var(--s24);
  }

  header.visible {
    top: 0;
  }

  menu {
    display: flex;
    list-style: none;
    gap: var(--s16);
    padding: 0;
    margin: 0;
  }

  li {
    margin: 0;
  }

  h1 {
    text-wrap: nowrap;
  }

  .category-summary {
    display: flex;
    align-items: center;
    gap: var(--s4);
    font-weight: 600;
    cursor: pointer;
  }

  .category {
    position: relative;
  }

  .category-content {
    position: absolute;
    padding: var(--s12);
    background: var(--bg);
    border: 1px solid var(--text-color);
    right: 0;
    top: calc(100% + var(--s8));
    flex-direction: column;
    gap: var(--s8);
    width: fit-content;
    display: none;

    a {
      text-wrap: nowrap;
      text-align: right;
    }
  }

  .category:has(a[aria-current="page"]) {
    .category-summary {
      text-decoration-color: var(--accent-color) !important;
      text-decoration: underline;
      text-decoration-style: wavy;
      text-underline-position: under;
    }
  }

  @media (max-width: 1030px) {
    .desktop {
      display: none;
    }
  }
</style>
