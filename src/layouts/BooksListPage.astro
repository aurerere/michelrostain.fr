---
import type { CollectionEntry } from "astro:content";
import BreadCrumb from "../components/BreadCrumb.astro";
import Layout from "./Layout.astro";
import ContentWrapper from "../components/ContentWrapper.astro";
import BookListItem from "../components/BookListItem.astro";

interface Props {
  entries: CollectionEntry<"books">[];
  kind: CollectionEntry<"books">["data"]["kind"];
}

const { entries, kind } = Astro.props;
---

<Layout>
  <ContentWrapper>
    <BreadCrumb
      current={kind === "essay" ? "Essais" : "Romans"}
      previous={[]}
    />
    <div class="list">
      {entries.map((entry) => (
        <BookListItem entry={entry} />
      ))}
    </div>
  </ContentWrapper>
</Layout>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
    gap: var(--s16);
    margin-bottom: var(--s24);
  }

  @media (max-width: 810px) {
    .list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 620px) {
    .list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 430px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
