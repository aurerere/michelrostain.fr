---
import { getCollection } from "astro:content";
import BooksListPage from "../../layouts/BooksListPage.astro";

const books = await getCollection("books");

const novels = books
  .filter((book) => book.data.kind === "novel")
  .sort((a, b) => b.data.publish_at.getTime() - a.data.publish_at.getTime());
---

<BooksListPage entries={novels} kind="novel" />
