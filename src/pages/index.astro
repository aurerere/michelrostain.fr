---
import { Icon } from "astro-icon/components";
import ContentWrapper from "../components/ContentWrapper.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import BookListItem from "../components/BookListItem.astro";

const bio = await getEntry({
  collection: "pages",
  id: "home",
});

const books = await getCollection("books");

const novels = books
  .filter((book) => book.data.kind === "novel")
  .sort((a, b) => a.data.publish_at.getTime() - b.data.publish_at.getTime());

const essays = books
  .filter((book) => book.data.kind === "essay")
  .sort((a, b) => a.data.publish_at.getTime() - b.data.publish_at.getTime());

const { Content: Bio } = await render(bio);
---

<Layout>
  <ContentWrapper>
    <div class="about">
      <Bio />
    </div>
    <hr />
    <div class="novels-header">
      <h2 class="no-margin">Romans</h2>
      <a href="/romans" class="more">
        Tout les romans <Icon name="arrow-right" />
      </a>
    </div>
    <div class="list">
      {novels.map((entry) => (
        <BookListItem entry={entry} />
      ))}
    </div>
    <hr />
    <div class="novels-header">
      <h2 class="no-margin">Essais</h2>
      <a href="/essais" class="more">
        Tout les essais <Icon name="arrow-right" />
      </a>
    </div>
    <div class="list">
      {essays.map((entry) => (
        <BookListItem entry={entry} />
      ))}
    </div>
  </ContentWrapper>
</Layout>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
    gap: var(--s16);
    margin-bottom: var(--s24);
  }

  .all {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .novels-header {
    display: flex;
    align-items: center;
    gap: var(--s16);
    margin-bottom: 1rem;
  }

  .more {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }

  .about {
    margin-bottom: var(--s24);
  }

  @media (max-width: 810px) {
    .list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 620px) {
    .list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 430px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
