---
import ContentWrapper from "../components/ContentWrapper.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

const bio = await getEntry({
  collection: "pages",
  id: "home",
});

const books = await getCollection("books");

const essays = books.filter((book) => book.data.kind === "essay");
const novels = books.filter((book) => book.data.kind === "novel");

const { Content: Bio } = await render(bio);
---

<Layout>
  <ContentWrapper>
    <h2>Romans</h2>
    <div class="list">
      {novels.map((entry) => (
        <div class="item">
          <img
            src={entry.data.covers[0] ?? ""}
            alt={`Couverture de '${entry.data.title}'`}
          />
          <div class="desc">
            <h4 class="no-margin">{entry.data.title}</h4>
            <p class="no-margin muted">
              {entry.data.publish_at.getFullYear()} • {entry.data.publisher}
            </p>
          </div>
        </div>
      ))}
    </div>

    <hr />
    <div>
      <h2>A propos</h2>
      <Bio />
    </div>
  </ContentWrapper>
</Layout>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s4);
  }

  img {
    width: 100%;
  }

  .item {
    width: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--text-color);
    transition: transform 200ms ease-in-out;
    cursor: pointer;
  }

  .item:hover {
    transform: scale(1.005);
  }

  .desc {
    padding: var(--s8);
  }
</style>
